# =============================================================================
# VT-SaiBER Environment Variables
# =============================================================================
# IMPORTANT: This is an example file, never commit .env to git!
# This file contains example values for environment variables used by VT-SaiBER.
# Copy this file to .env and fill in the actual values before running the application.

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Optional: dedicated hosted-embeddings key. Falls back to OPENROUTER_API_KEY if unset.
OPENROUTER_EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# Shared LLM Configuration (all agents)
# -----------------------------------------------------------------------------
# Prefer a paid non-`:free` model for live smoke tests.
OPENROUTER_MODEL=provider/model-name
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SUPERVISOR_TIMEOUT_SECONDS=90
SUPERVISOR_REASONING_ENABLED=true
SUPERVISOR_MAX_REASONING_MESSAGES=12
OPENROUTER_MAX_RETRIES=3
OPENROUTER_RETRY_DELAY_SECONDS=1
TOOL_MAX_RETRIES=3
TOOL_RETRY_DELAY_SECONDS=1
RUNTIME_LOG_MAX_CHARS=12000

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
# Hosted embeddings will use OPENROUTER_EMBEDDING_API_KEY when set, else OPENROUTER_API_KEY.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=whatevermodelyouwant
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Safety Controls
# -----------------------------------------------------------------------------
STRIKER_REQUIRE_CONFIRMATION=true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_PASSWORD=choose_a_strong_password_here
DB_HOST=some_host_here
DB_PORT=some_port_here
DB_NAME=some_name_here
DB_USER=some_name_here

# -----------------------------------------------------------------------------
# RAG Retrieval Tuning
# -----------------------------------------------------------------------------
RAG_KB_TOP_K=8
RAG_KB_FETCH_K=24
RAG_FINDINGS_TOP_K=5
RAG_FINDINGS_FETCH_K=15
RAG_KB_SIMILARITY_THRESHOLD=0.58
RAG_FINDINGS_SIMILARITY_THRESHOLD=0.45
RAG_MIN_DOCS=3
RAG_MIN_SCORE=0.75
RAG_MAX_CHUNKS_PER_DOC=2

# -----------------------------------------------------------------------------
# Reporting
# -----------------------------------------------------------------------------
REPORT_EXPORT_DIR=

# -----------------------------------------------------------------------------
# Metasploit RPC Configuration
# -----------------------------------------------------------------------------
MSF_PASSWORD=another_strong_password_here
MSF_SERVER=some_server_here
MSF_PORT=some_port_here
MSF_SSL=true_or_false_here

# -----------------------------------------------------------------------------
# Unified Attackbox MCP URL (internal Docker network)
# -----------------------------------------------------------------------------
ATTACKBOX_MCP_URL=http://attackbox:8080/mcp

# -----------------------------------------------------------------------------
# Tavily API Configuration
# -----------------------------------------------------------------------------
TAVILY_API_KEY=sk-tavily-your-tavily-key-here
TAVILY_MAX_RESULTS=5
